{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/harnessbench/run-result.schema.json",
  "title": "Harness benchmark run result",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark_version",
    "dataset",
    "task_id",
    "harness_id",
    "session_id",
    "status",
    "ship_ready",
    "completion_score",
    "wall_time_seconds",
    "usage",
    "tooling"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "benchmark_version": {"type": "string"},
    "dataset": {"type": "string"},
    "task_id": {"type": "string"},
    "harness_id": {"type": "string"},
    "session_id": {"type": "string"},
    "status": {
      "enum": ["completed", "timeout", "harness_failed", "invalid", "infrastructure_invalidated"]
    },
    "ship_ready": {"type": "boolean"},
    "completion_score": {"type": "number", "minimum": 0, "maximum": 100},
    "critical_failures": {"type": "array", "items": {"type": "string"}},
    "wall_time_seconds": {"type": "number", "minimum": 0},
    "model_active_seconds": {"type": ["number", "null"], "minimum": 0},
    "usage": {
      "type": "object",
      "required": ["input_tokens", "cached_input_tokens", "output_tokens", "reasoning_tokens", "credits"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "reasoning_tokens": {"type": "integer", "minimum": 0},
        "credits": {"type": ["number", "null"], "minimum": 0},
        "api_equivalent_cost_usd": {"type": ["number", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "tooling": {
      "type": "object",
      "required": ["tool_calls", "failed_tool_calls", "test_cycles", "human_interventions"],
      "properties": {
        "tool_calls": {"type": "integer", "minimum": 0},
        "failed_tool_calls": {"type": "integer", "minimum": 0},
        "test_cycles": {"type": "integer", "minimum": 0},
        "human_interventions": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
